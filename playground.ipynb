   "source": [
    "import json\n",
    "goodkeys = []\n",
    "with open(\"dataset/metadata/antibiotic_counts.json\") as file:\n",
    "    data = json.load(file)\n",
    "    for key in list(data.keys()):\n",
    "        if data[key] > 4500 and data[key] < 15000:\n",
    "            goodkeys.append(key)\n",
    "\n",
    "print(goodkeys)"
   ]
